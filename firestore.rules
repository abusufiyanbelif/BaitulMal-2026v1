rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- TEMPORARY DIAGNOSTIC ---
    match /audit_logs/{logId} {
      allow read, list: if true; 
      allow write: if request.auth != null;
    }

    // --- GLOBAL HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Priority 1: Hardcoded Master Admins
      let masterAdmins = [
        'cyMl1lQME0Yur1YS3VCms1AvrOJ2', 
        'S5efNV5jpTPoxYNv6SnAlv3jNPO2', 
        '3gKwUE2JrBT8wngoUxTTN6tLJk03'
      ];
      let masterEmails = [
        'baitulmalss.solapur@gmail.com', 
        'abusufiyan.belif@gmail.com', 
        'maazshaikh.official@gmail.com',
        'admin@example.com'
      ];
      
      return isSignedIn() && (
        request.auth.uid in masterAdmins || 
        (request.auth.token.email != null && request.auth.token.email in masterEmails) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin')
      );
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'User')
      );
    }

    function hasPermission(module, perm) {
      return isSignedIn() && (
        isAdmin() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions[module][perm] == true) ||
            (module == 'leads' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions['leads-members'][perm] == true) ||
            (module == 'leads-members' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions['leads'][perm] == true)
          )
        )
      );
    }

    // --- EMERGENCY PUBLIC ACCESS ---
    match /settings/branding { allow read: if true; }
    match /settings/payment { allow read: if true; }
    match /settings/donation_visibility { allow read: if true; }
    match /settings/campaign_visibility { allow read: if true; }
    match /settings/lead_visibility { allow read: if true; }
    match /settings/beneficiary_visibility { allow read: if true; }
    match /settings/donationInfo { allow read: if true; }
    match /settings/guidingPrinciples { allow read: if true; }
    match /settings/info { allow read: if true; }
    match /settings/guidance { allow read: if true; }
    
    match /settings/campaign_config { allow read: if true; }
    match /settings/lead_config { allow read: if true; }
    match /settings/donation_config { allow read: if true; }
    match /settings/beneficiary_config { allow read: if true; }
    match /settings/user_config { allow read: if true; }
    match /settings/donor_config { allow read: if true; }

    match /message_logs/{logId} {
      allow read: if isStaff() || hasPermission('messages', 'read');
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
      match /{allSubCollections=**} {
        allow read: if isStaff();
        allow write: if isAdmin();
      }
    }

    match /donations/{donationId} {
      allow read: if isStaff() || 
                   (resource != null && resource.data.status == 'Verified') || 
                   (isSignedIn() && resource != null && request.auth.uid == resource.data.donorId);
      allow write: if isAdmin() || hasPermission('donations', 'update');
      allow create: if true;
    }

    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if isAdmin() || hasPermission('campaigns', 'update');
      match /beneficiaries/{benId} {
        allow read: if true;
        allow write: if isStaff();
      }
    }

    match /leads/{leadId} {
      allow read: if true;
      allow write: if isAdmin() || hasPermission('leads', 'update') || hasPermission('leads-members', 'update');
      match /beneficiaries/{benId} {
        allow read: if true;
        allow write: if isStaff();
      }
    }

    match /beneficiaries/{benId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /donors/{donorId} {
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == donorId);
      allow write: if isAdmin() || hasPermission('donors', 'update');
    }

    match /users/{userId} {
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /user_lookups/{lookupId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /pending_verifications/{reqId} {
      allow read: if isStaff() || (isSignedIn() && resource != null && request.auth.uid == resource.data.requestedBy.id);
      allow write: if isSignedIn();
    }

    match /page_hits/{pageId} {
      allow read: if isStaff();
      allow write: if true;
    }
  }
}