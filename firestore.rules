rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPERS (Indestructible Auth Logic) ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Bulletproof Admin check: Prioritizes hardcoded Master IDs to prevent Rule Execution Limit failures
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid in ['cyMl1lQME0Yur1YS3VCms1AvrOJ2', 'S5efNV5jpTPoxYNv6SnAlv3jNPO2', '3gKwUE2JrBT8wngoUxTTN6tLJk03'] ||
        (request.auth.token.email != null && request.auth.token.email in ['baitulmalss.solapur@gmail.com', 'abusufiyan.belif@gmail.com', 'maazshaikh.official@gmail.com', 'admin@example.com']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin')
      );
    }

    // Staff includes Admins and registered team members (Users)
    function isStaff() {
      return isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'User')
      );
    }

    // Granular permission check for staff members
    function hasPermission(module, perm) {
      return isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions[module][perm] == true) ||
        (module == 'leads' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions['leads-members'][perm] == true) ||
        (module == 'leads-members' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions['leads'][perm] == true)
      ));
    }

    // --- SYSTEM & LOGGING (Staff Only) ---
    match /audit_logs/{allPaths=**} {
      allow read: if isStaff();
      allow write: if isSignedIn(); // System logging
    }

    match /message_logs/{allPaths=**} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /notification_groups/{allPaths=**} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /page_hits/{allPaths=**} {
      allow read: if isStaff();
      allow write: if true; // Public analytics
    }

    // --- GLOBAL SETTINGS & BRANDING ---
    match /settings/{docId} {
      // Branding and visibility configs are public
      allow read: if docId in [
        'branding', 'payment', 'donation_visibility', 'campaign_visibility', 
        'lead_visibility', 'beneficiary_visibility', 'donationInfo', 
        'guidingPrinciples', 'info', 'guidance', 'campaign_config', 
        'lead_config', 'donation_config', 'beneficiary_config', 
        'user_config', 'donor_config', 'notifications'
      ] || isStaff();
      
      allow write: if isAdmin() || hasPermission('settings', 'update');

      match /{allSubCollections=**} {
        allow read: if isStaff();
        allow write: if isAdmin();
      }
    }

    // --- CORE MODULES ---

    match /donations/{donationId} {
      // Donors can read their own receipts; Public sees verified list; Staff sees all.
      allow read: if isStaff() || 
                   (resource != null && resource.data.status == 'Verified') || 
                   (isSignedIn() && resource != null && request.auth.uid == resource.data.donorId);
      allow write: if isAdmin() || hasPermission('donations', 'update');
      allow create: if true; // Anonymous donations supported
    }

    match /campaigns/{campaignId} {
      allow read: if true; // Public initiatives
      allow write: if isAdmin() || hasPermission('campaigns', 'update');
      match /beneficiaries/{benId} {
        allow read: if true;
        allow write: if isStaff();
      }
    }

    match /leads/{leadId} {
      allow read: if true; // Public leads
      allow write: if isAdmin() || hasPermission('leads', 'update') || hasPermission('leads-members', 'update');
      match /beneficiaries/{benId} {
        allow read: if true;
        allow write: if isStaff();
      }
    }

    match /beneficiaries/{benId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /donors/{donorId} {
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == donorId);
      allow write: if isAdmin() || hasPermission('donors', 'update') || (isSignedIn() && request.auth.uid == donorId);
    }

    match /users/{userId} {
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /user_lookups/{lookupId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /pending_verifications/{reqId} {
      allow read: if isStaff() || (isSignedIn() && resource != null && request.auth.uid == resource.data.requestedBy.id);
      allow write: if isSignedIn();
    }
  }
}