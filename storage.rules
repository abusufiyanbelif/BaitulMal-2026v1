rules_version = '2';
service cloud.storage {
  match /b/{bucket}/o {
    
    // --- HELPER FUNCTIONS (Indestructible Auth) ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid in ['S5efNV5jpTPoxYNv6SnAlv3jNPO2', 'cyMl1lQME0Yur1YS3VCms1AvrOJ2', '3gKwUE2JrBT8wngoUxTTN6tLJk03'] || 
        (request.auth.token.email != null && request.auth.token.email in ['abusufiyan.belif@gmail.com', 'baitulmalss.solapur@gmail.com', 'maazshaikh.official@gmail.com', 'admin@example.com']) ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && 
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'Admin')
      );
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() || 
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && 
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'User')
      );
    }


    // --- RULES ---

    // Public settings files (logo, QR, Branding Assets)
    match /settings/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Member profile artifacts
    match /users/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Initiative artifacts (Campaigns & Leads)
    match /campaigns/{id}/{allPaths=**} {
      allow read: if true; // Public initiatives
      allow write: if isAdmin() || isStaff();
    }

    match /leads/{id}/{allPaths=**} {
      allow read: if true; // Public leads
      allow write: if isAdmin() || isStaff();
    }

    // Beneficiary artifacts (Sensitive documents)
    match /beneficiaries/{id}/{allPaths=**} {
      // Staff can read everything; Public only if specifically flagged; Beneficiaries read their own
      allow read: if isStaff() || (
        firestore.exists(/databases/(default)/documents/beneficiaries/$(id)) && (
          firestore.get(/databases/(default)/documents/beneficiaries/$(id)).data.isPublic == true || 
          firestore.get(/databases/(default)/documents/beneficiaries/$(id)).data.idProofIsPublic == true ||
          (isSignedIn() && (
            id == request.auth.uid ||
            (
              firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
              id == firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.linkedBeneficiaryId
            )
          ))
        )
      );
      allow write: if isStaff();
    }

    // Donation artifacts (Payment Screenshots)
    match /donations/{id}/{allPaths=**} {
      // Staff can read all; Donors can read their own; Public only if flagged
      allow read: if isStaff() || (
        firestore.exists(/databases/(default)/documents/donations/$(id)) && (
          firestore.get(/databases/(default)/documents/donations/$(id)).data.isPublic == true || 
          firestore.get(/databases/(default)/documents/donations/$(id)).data.screenshotIsPublic == true ||
          (isSignedIn() && (
            firestore.get(/databases/(default)/documents/donations/$(id)).data.donorId == request.auth.uid ||
            (
              firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
              firestore.get(/databases/(default)/documents/donations/$(id)).data.donorId == firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.linkedDonorId
            )
          ))
        )
      );
      allow write: if true; // Allow guest donation submissions
    }
  }
}